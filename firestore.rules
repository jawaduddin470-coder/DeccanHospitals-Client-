rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Explicit administrator authorization check:
    // Requires authenticated user with custom claim (token.admin == true) OR verified record in /admins/{uid}
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'deccancarehospital.24ths@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Super Admin authorization check:
    function isSuperAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'superadmin' ||
        request.auth.token.email == 'deccancarehospital.24ths@gmail.com' ||
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
         (get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'superadmin' ||
          get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'hospital_admin'))
      );
    }

    // Admins Collection: Read for any admin, Write for Super Admins or user updating their own profile
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow create, update, delete: if isSuperAdmin() || (request.auth != null && request.auth.uid == adminId);
    }

    // Admin Audit Logs: Read for Super Admins, Create for authenticated admins, Immutable (no update or delete)
    match /admin_audit_logs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // Hospital Info: Public read, Admin write
    match /hospitalInfo/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Doctors: Public read, Admin write
    match /doctors/{doctorId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Services: Public read, Admin write
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Gallery: Public read, Admin write
    match /gallery/{galleryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Availability Slots:
    // - Public read allowed for patients to view availability.
    // - Creation and deletion restricted strictly to authenticated administrators.
    // - Update allowed for public ONLY during atomic booking: transitioning from 'available' to 'booked'
    //   while strictly preserving doctor, date, times, and active state without tampering.
    match /availability/{slotId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if (
        resource.data.status == 'available' &&
        request.resource.data.status == 'booked' &&
        request.resource.data.doctorId == resource.data.doctorId &&
        request.resource.data.date == resource.data.date &&
        request.resource.data.startTime == resource.data.startTime &&
        request.resource.data.endTime == resource.data.endTime &&
        request.resource.data.active == resource.data.active &&
        request.resource.data.bookingId is string &&
        request.resource.data.bookingId.size() > 0
      ) || isAdmin();
    }

    // Appointments:
    // - Direct 'get' allowed for immediate patient confirmation receipt.
    // - Querying/listing appointments restricted to authenticated administrators.
    // - Public 'create' strictly validated (field types, string length bounds, pending status).
    // - Update and deletion restricted strictly to authenticated administrators.
    match /appointments/{appointmentId} {
      allow get: if true;
      allow list: if isAdmin();
      
      allow create: if (
        request.resource.data.patientName is string &&
        request.resource.data.patientName.size() >= 2 &&
        request.resource.data.patientName.size() <= 100 &&
        request.resource.data.phone is string &&
        request.resource.data.phone.size() >= 10 &&
        request.resource.data.phone.size() <= 15 &&
        request.resource.data.doctorId is string &&
        request.resource.data.doctorId.size() > 0 &&
        request.resource.data.date is string &&
        request.resource.data.date.size() == 10 &&
        request.resource.data.slotId is string &&
        request.resource.data.slotId.size() > 0 &&
        request.resource.data.startTime is string &&
        request.resource.data.startTime.size() > 0 &&
        request.resource.data.endTime is string &&
        request.resource.data.endTime.size() > 0 &&
        request.resource.data.status == 'pending' &&
        request.resource.data.notificationStatus == 'pending'
      ) || isAdmin();

      allow update, delete: if isAdmin();
    }
  }
}
